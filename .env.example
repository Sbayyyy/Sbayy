EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_ENABLE_SSL=true
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=

JWT_ISSUER=SBay
JWT_AUDIENCE=SBayClients
JWT_SECRET=dev_only_change_me_32_bytes_minimum_value
