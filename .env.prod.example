COMPOSE_PROJECT_NAME=sbay

DOMAIN_NAME=syrian-bay.com
FRONTEND_URL=https://syrian-bay.com
FRONTEND_WWW_URL=https://www.syrian-bay.com
APP_PUBLIC_BASE_URL=https://api.syrian-bay.com
EMAIL_VERIFICATION_TOKEN_HOURS=24
EMAIL_FROM=support@syrian-bay.com
EMAIL_FROM_NAME=SBay
SUPPORT_EMAIL=support@syrian-bay.com
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_ENABLE_SSL=true
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
NEXT_PUBLIC_API_URL=https://api.syrian-bay.com
NEXT_PUBLIC_API_PROXY_TARGET=http://backend:8080
NEXT_PUBLIC_SUPPORT_EMAIL=support@syrian-bay.com
RUNTIME_SUPPORT_EMAIL=support@syrian-bay.com
NEXT_PUBLIC_SITE_URL=https://syrian-bay.com
NEXT_PUBLIC_LOGO_URL=/assets/sbaylogo2.png
NEXT_PUBLIC_OPTIMIZED_IMAGE_HOSTS=
RUNTIME_LOGO_URL=/assets/sbaylogo2.png

API_HOST_PORT=5000
WEB_HOST_PORT=3000

DB_PASSWORD=replace_with_secure_database_password
CONNECTION_STRING=Host=postgres;Port=5432;Database=sbay;Username=sbay;Password=replace_with_secure_database_password

JWT_ISSUER=SBay
JWT_AUDIENCE=SBayClients
# JWT_SECRET signs access JWTs only. Refresh tokens are opaque random strings
# stored hashed in Postgres; JWT_REFRESH_TOKEN_DAYS controls their lifetime.
JWT_SECRET=replace_with_32_character_minimum_random_secret
JWT_EXP_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=180

UPLOADS_HOST_PATH=/var/sbay/uploads
STORAGE_LOCAL_PATH=/app/uploads
STORAGE_LOCAL_PUBLIC_BASE_URL=https://api.syrian-bay.com/uploads
DELETE_UPLOAD_FILES=false
CLEANUP_UNUSED_UPLOADS_CONFIRM=
UNUSED_IMAGE_RETENTION_DAYS=7

PAYMENTS_PROVIDER=mock
PAYMENTS_MOCK_WEBHOOK_SECRET=replace_with_random_webhook_secret
MONETIZATION_CURRENCY=SYP
MONETIZATION_COMMISSION_PERCENT=5
ACCOUNT_DELETION_GRACE_DAYS=90
ACCOUNT_DELETION_CLEANUP_ENABLED=true
ACCOUNT_DELETION_CLEANUP_INTERVAL_HOURS=24
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
